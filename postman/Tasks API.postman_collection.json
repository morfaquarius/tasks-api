{
  "info": {
    "_postman_id": "4d48f1b1-38e5-4b56-8e21-2bcf87c4fc7f",
    "name": "Tasks API",
    "description": "Коллекция для локального Tasks API. Перед запуском запросов убедитесь, что сервер запущен на {{baseUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9091",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Проверить, что сервер доступен. Ожидается 200 OK и {\"status\":\"ok\"}."
      },
      "response": []
    },
    {
      "name": "Create task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const task = pm.response.json();",
              "    pm.collectionVariables.set('taskId', String(task.id));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Подготовить отчет\",\n  \"description\": \"Собрать результаты за неделю\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "description": "Создать задачу. При успешном ответе ID созданной задачи автоматически сохраняется в переменную коллекции taskId."
      },
      "response": []
    },
    {
      "name": "List tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "description": "Получить массив всех задач. Если задач нет, сервер возвращает []."
      },
      "response": []
    },
    {
      "name": "Get task",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "description": "Получить задачу по ID из переменной taskId. Сначала выполните Create task или задайте существующий ID вручную."
      },
      "response": []
    },
    {
      "name": "Update task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Подготовить отчет\",\n  \"description\": \"Отчет готов и отправлен\",\n  \"done\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "description": "Полностью обновить задачу. Поля title, description и done обязательны."
      },
      "response": []
    },
    {
      "name": "Delete task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "description": "Удалить задачу по ID. При успехе сервер возвращает 204 No Content."
      },
      "response": []
    }
  ]
}
